{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "resolveJsonModule": true,
    "allowJs": false,
    "noImplicitAny": false,
    "ignoreDeprecations": "6.0",
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"] 
    },
    "typeRoots": [
      "./src/types",
      "./node_modules/@types"
    ],
    "sourceMap": true,
    "esModuleInterop": true,
    "strict": true
  },
  "include": [
    "src/**/*.ts",
    "prisma/**/*.prisma",
    "src/generated/**/*",
    "src/types/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}