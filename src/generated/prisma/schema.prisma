generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  //  url      = env("DATABASE_URL")
}

// 1. USUARIOS DEL SISTEMA (Para login)
// Puedes vincular esto a Profesionales o Administrativos
model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String // Hash con bcrypt
  role      String // 'ADMIN', 'MEDICO', 'ENFERMERO'
  createdAt DateTime @default(now())
}

// 2. PACIENTES (PersonasAtendidas)
model Paciente {
  id              Int      @id @default(autoincrement())
  tipoDocumento   String // CC, TI, CE
  numeroDocumento String   @unique
  nombres         String
  apellidos       String
  fechaNacimiento DateTime
  sexo            String
  correo          String?
  telefono        String
  direccion       String?
  estado          Boolean  @default(true) // Activo/Inactivo

  citas     Cita[]
  episodios EpisodioAtencion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 3. PROFESIONALES
model Profesional {
  id               Int     @id @default(autoincrement())
  nombres          String
  apellidos        String
  registroMedico   String  @unique // Tarjeta profesional
  especialidad     String
  correo           String  @unique
  telefono         String?
  agendaHabilitada Boolean @default(true)

  bloquesAgenda BloqueAgenda[]
  citas         Cita[]
  notas         NotaClinica[]
}

// 4. UNIDADES DE ATENCION (Sedes)
model UnidadAtencion {
  id        Int     @id @default(autoincrement())
  nombre    String
  tipo      String // Sede, Consultorio
  direccion String
  estado    Boolean @default(true)

  bloquesAgenda BloqueAgenda[]
  citas         Cita[]
}

// 5. AGENDA (Bloques de tiempo disponibles)
model BloqueAgenda {
  id          Int      @id @default(autoincrement())
  fechaInicio DateTime
  fechaFin    DateTime
  capacidad   Int      @default(1)
  estado      String // 'ABIERTO', 'CERRADO'

  profesional   Profesional    @relation(fields: [profesionalId], references: [id])
  profesionalId Int
  unidad        UnidadAtencion @relation(fields: [unidadId], references: [id])
  unidadId      Int
}

// 6. CITAS
model Cita {
  id          Int      @id @default(autoincrement())
  fechaInicio DateTime
  fechaFin    DateTime
  motivo      String
  estado      String // 'SOLICITADA', 'CONFIRMADA', 'CANCELADA'
  canal       String // 'PRESENCIAL', 'VIRTUAL'

  paciente      Paciente       @relation(fields: [pacienteId], references: [id])
  pacienteId    Int
  profesional   Profesional    @relation(fields: [profesionalId], references: [id])
  profesionalId Int
  unidad        UnidadAtencion @relation(fields: [unidadId], references: [id])
  unidadId      Int
}

// 7. REGISTRO CLINICO (Simplificado para inicio)
model EpisodioAtencion {
  id     Int      @id @default(autoincrement())
  motivo String
  fecha  DateTime @default(now())
  estado String // 'ABIERTO', 'CERRADO'

  paciente   Paciente @relation(fields: [pacienteId], references: [id])
  pacienteId Int

  notas NotaClinica[]
}

model NotaClinica {
  id        Int      @id @default(autoincrement())
  subjetivo String // Lo que dice el paciente
  objetivo  String // Lo que ve el medico
  analisis  String
  plan      String
  fecha     DateTime @default(now())

  episodio      EpisodioAtencion @relation(fields: [episodioId], references: [id])
  episodioId    Int
  profesional   Profesional      @relation(fields: [profesionalId], references: [id])
  profesionalId Int
}
